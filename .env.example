ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
HOST=127.0.0.1
PORT=8000

# Database: sqlite or mysql
DB_ENGINE=sqlite
DB_PATH=data/chatbot.db

# Use these only when DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=chatbot

# Optional trained model artifact paths
SENTIMENT_MODEL_PATH=models/sentiment_bert
TOXICITY_MODEL_PATH=models/toxicity_bert
ENGAGEMENT_MODEL_PATH=models/engagement_xgboost.pkl
SCHEDULING_MODEL_PATH=models/scheduling_random_forest.pkl

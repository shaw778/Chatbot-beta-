ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6
HOST=127.0.0.1
PORT=8000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_IMAGE_REQUESTS=10

# Social publishing OAuth apps. Create these in Meta and X developer consoles.
# Never commit your real .env file or expose these values in frontend JavaScript.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=replace_with_a_long_random_value
META_PAGE_ACCESS_TOKEN=
META_REQUIRE_SIGNATURE=false
META_REDIRECT_URI=https://rights-diameter-katrina-actress.trycloudflare.com/auth/meta/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/auth/x/callback
OAUTH_STATE_SECRET=replace_with_a_long_random_value
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_ENCRYPTION_KEY=

# Database: sqlite or mysql
DB_ENGINE=sqlite
DB_PATH=data/chatbot.db

# Use these only when DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=chatbot

# Optional trained model artifact paths
SENTIMENT_MODEL_PATH=models/sentiment_bert
TOXICITY_MODEL_PATH=models/toxicity_bert
ENGAGEMENT_MODEL_PATH=models/engagement_xgboost.pkl
SCHEDULING_MODEL_PATH=models/scheduling_random_forest.pkl

# SSLCommerz Payment Gateway Configuration
# Default sandbox credentials provided for testing (testbox / qwerty)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWD=qwerty
SSLCOMMERZ_IS_SANDBOX=true
APP_BASE_URL=http://127.0.0.1:8000
